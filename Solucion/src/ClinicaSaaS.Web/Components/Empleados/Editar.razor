@page "/empleados/{EmpleadoId:guid}/editar"
@attribute [Authorize(Policy = ClinicaSaaSAuthorizationPolicies.AdminClinica)]
@rendermode InteractiveServer
@using ClinicaSaaS.Application.Empleados
@using ClinicaSaaS.Infrastructure.Identity
@inject IEmpleadoService EmpleadoService
@inject NavigationManager NavigationManager

<PageTitle>Editar empleado</PageTitle>

@if (_empleado is null && !_noEncontrado)
{
    <p><em>Cargando...</em></p>
}
else if (_noEncontrado)
{
    <p role="alert">Ese empleado no existe.</p>
    <a class="btn btn-link" href="empleados">Volver al listado</a>
}
else
{
    var empleado = _empleado!;

    <h1>Editar empleado de @empleado.NombreUsuario</h1>

    <dl class="row">
        <dt class="col-sm-2">Usuario</dt>
        <dd class="col-sm-10">@empleado.NombreUsuario (@empleado.EmailUsuario)</dd>
        <dt class="col-sm-2">Clínica</dt>
        <dd class="col-sm-10">@empleado.NombreClinica</dd>
    </dl>
    <p><em>El usuario y la clínica no se editan aquí — para eso hay que revocar y volver a registrar el empleado.</em></p>

    @if (_mensajeError is not null)
    {
        <div class="alert alert-danger" role="alert">@_mensajeError</div>
    }
    @if (_mensajeExito is not null)
    {
        <div class="alert alert-success" role="alert">@_mensajeExito</div>
    }

    <EditForm Model="_modelo" OnValidSubmit="GuardarAsync">
        <div class="mb-3" style="max-width: 500px;">
            <label for="cargo" class="form-label">Cargo</label>
            <InputText id="cargo" class="form-control" @bind-Value="_modelo.Cargo" />
        </div>

        <div class="mb-3" style="max-width: 300px;">
            <label for="fechaIngreso" class="form-label">Fecha de ingreso (opcional)</label>
            <InputDate id="fechaIngreso" class="form-control" @bind-Value="_modelo.FechaIngreso" />
        </div>

        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a class="btn btn-link" href="empleados">Volver al listado</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid EmpleadoId { get; set; }

    private EmpleadoDto? _empleado;
    private bool _noEncontrado;
    private string? _mensajeError;
    private string? _mensajeExito;
    private readonly ModeloDatosEmpleado _modelo = new();

    protected override async Task OnInitializedAsync()
    {
        _empleado = await EmpleadoService.ObtenerAsync(EmpleadoId);
        if (_empleado is null)
        {
            _noEncontrado = true;
            return;
        }

        _modelo.Cargo = _empleado.Cargo;
        _modelo.FechaIngreso = _empleado.FechaIngreso;
    }

    private async Task GuardarAsync()
    {
        _mensajeError = null;
        _mensajeExito = null;

        var resultado = await EmpleadoService.ActualizarDatosAsync(
            EmpleadoId, new ActualizarDatosEmpleadoRequest(_modelo.Cargo, _modelo.FechaIngreso));

        if (resultado.EsFallido)
        {
            _mensajeError = resultado.Error.Descripcion;
            return;
        }

        _mensajeExito = "Datos actualizados.";
    }

    private sealed class ModeloDatosEmpleado
    {
        public string Cargo { get; set; } = string.Empty;
        public DateOnly? FechaIngreso { get; set; }
    }
}
