@page "/empleados/nuevo"
@attribute [Authorize(Policy = ClinicaSaaSAuthorizationPolicies.AdminClinica)]
@rendermode InteractiveServer
@using ClinicaSaaS.Application.Clinicas
@using ClinicaSaaS.Application.Common.Interfaces
@using ClinicaSaaS.Application.Empleados
@using ClinicaSaaS.Application.Usuarios
@using ClinicaSaaS.Infrastructure.Identity
@inject IEmpleadoService EmpleadoService
@inject IUsuarioService UsuarioService
@inject IClinicaService ClinicaService
@inject ITenantContext TenantContext
@inject NavigationManager NavigationManager

<PageTitle>Nuevo empleado</PageTitle>

<h1>Nuevo empleado</h1>

@if (_mensajeError is not null)
{
    <div class="alert alert-danger" role="alert">@_mensajeError</div>
}

@if (_usuarios is null)
{
    <p><em>Cargando...</em></p>
}
else
{
    <EditForm Model="_modelo" OnValidSubmit="GuardarAsync">
        <div class="mb-3" style="max-width: 500px;">
            <label for="usuario" class="form-label">Usuario</label>
            <InputSelect id="usuario" class="form-select" @bind-Value="_modelo.UsuarioId">
                <option value="">-- Selecciona un usuario --</option>
                @foreach (var usuario in _usuarios)
                {
                    <option value="@usuario.Id">@usuario.NombreCompleto (@usuario.Email)</option>
                }
            </InputSelect>
            <div class="form-text">
                El usuario debe existir de antes (módulo Usuarios) — aquí solo se vincula a esta clínica con un cargo.
            </div>
        </div>

        @if (TenantContext.ClinicaId is null)
        {
            <div class="mb-3" style="max-width: 500px;">
                <label for="clinica" class="form-label">Clínica</label>
                <InputSelect id="clinica" class="form-select" @bind-Value="_modelo.ClinicaId">
                    <option value="">-- Selecciona una clínica --</option>
                    @foreach (var clinica in _clinicas!)
                    {
                        <option value="@clinica.Id">@clinica.NombreComercial</option>
                    }
                </InputSelect>
                <div class="form-text">
                    Como SuperAdmin SaaS puedes elegir la clínica; un AdminClinica normal registra
                    empleados directo en su propia clínica, sin este selector.
                </div>
            </div>
        }

        <div class="mb-3" style="max-width: 500px;">
            <label for="cargo" class="form-label">Cargo</label>
            <InputText id="cargo" class="form-control" @bind-Value="_modelo.Cargo" placeholder="Ej. Recepcionista" />
        </div>

        <div class="mb-3" style="max-width: 300px;">
            <label for="fechaIngreso" class="form-label">Fecha de ingreso (opcional)</label>
            <InputDate id="fechaIngreso" class="form-control" @bind-Value="_modelo.FechaIngreso" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_guardando">Registrar empleado</button>
        <a class="btn btn-link" href="empleados">Cancelar</a>
    </EditForm>
}

@code {
    private IReadOnlyList<UsuarioDto>? _usuarios;
    private IReadOnlyList<ClinicaDto>? _clinicas;
    private readonly ModeloNuevoEmpleado _modelo = new();
    private string? _mensajeError;
    private bool _guardando;

    protected override async Task OnInitializedAsync()
    {
        // Igual que en Usuarios/Editar.razor (Fase 6, Módulo 2): nunca cargar en paralelo dos
        // operaciones que usan servicios de Application — comparten la misma instancia Scoped
        // de ClinicaSaaSDbContext y EF Core no soporta dos operaciones async simultáneas sobre
        // el mismo DbContext. Secuencial, siempre.
        _usuarios = await UsuarioService.ListarAsync();

        // El selector de clínica solo hace falta para un SuperAdmin SaaS (sin clínica activa
        // en su sesión) — un AdminClinica normal no lo necesita, así que no cargamos la lista
        // completa de clínicas de balde en ese caso.
        if (TenantContext.ClinicaId is null)
            _clinicas = await ClinicaService.ListarAsync();
    }

    private async Task GuardarAsync()
    {
        _guardando = true;
        _mensajeError = null;

        if (!Guid.TryParse(_modelo.UsuarioId, out var usuarioId))
        {
            _mensajeError = "Selecciona un usuario.";
            _guardando = false;
            return;
        }

        // Si hay clínica activa en la sesión, se usa esa (el formulario ni siquiera muestra el
        // selector en ese caso) — el propio EmpleadoService también hace cumplir esto del lado
        // del servidor, por si acaso.
        Guid clinicaId;
        if (TenantContext.ClinicaId is Guid clinicaActiva)
        {
            clinicaId = clinicaActiva;
        }
        else if (!Guid.TryParse(_modelo.ClinicaId, out clinicaId))
        {
            _mensajeError = "Selecciona una clínica.";
            _guardando = false;
            return;
        }

        var resultado = await EmpleadoService.RegistrarAsync(
            new RegistrarEmpleadoRequest(usuarioId, clinicaId, _modelo.Cargo, _modelo.FechaIngreso));

        if (resultado.EsFallido)
        {
            _mensajeError = resultado.Error.Descripcion;
            _guardando = false;
            return;
        }

        NavigationManager.NavigateTo("empleados");
    }

    private sealed class ModeloNuevoEmpleado
    {
        public string UsuarioId { get; set; } = string.Empty;
        public string ClinicaId { get; set; } = string.Empty;
        public string Cargo { get; set; } = string.Empty;
        public DateOnly? FechaIngreso { get; set; }
    }
}
