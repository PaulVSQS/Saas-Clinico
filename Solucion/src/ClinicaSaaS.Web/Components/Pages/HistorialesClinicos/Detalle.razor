@page "/historiales-clinicos/{PacienteId:guid}"
@attribute [Authorize(Policy = ClinicaSaaSAuthorizationPolicies.AdminClinica)]
@rendermode InteractiveServer
@using ClinicaSaaS.Application.Citas
@using ClinicaSaaS.Application.Doctores
@using ClinicaSaaS.Application.HistorialesClinicos
@using ClinicaSaaS.Application.Pacientes
@using ClinicaSaaS.Application.Procedimientos
@using ClinicaSaaS.Domain.Clinical.Enums
@using ClinicaSaaS.Infrastructure.Identity
@using Microsoft.AspNetCore.Components.Forms
@inject IPacienteService PacienteService
@inject IDoctorService DoctorService
@inject ICitaService CitaService
@inject IHistorialClinicoService HistorialClinicoService
@inject IArchivoClinicoService ArchivoClinicoService
@inject IProcedimientoCatalogoService ProcedimientoCatalogoService
@inject IProcedimientoRealizadoService ProcedimientoRealizadoService

<PageTitle>Historial clínico</PageTitle>

@if (_paciente is null && !_noEncontrado)
{
    <p><em>Cargando...</em></p>
}
else if (_noEncontrado)
{
    <p role="alert">Ese paciente no existe.</p>
    <a class="btn btn-link" href="historiales-clinicos">Volver al listado</a>
}
else
{
    var paciente = _paciente!;

    <h1>Historial clínico de @paciente.NombreCompleto</h1>
    <p>@paciente.NombreClinica</p>

    @if (_mensajeError is not null)
    {
        <div class="alert alert-danger" role="alert">@_mensajeError</div>
    }
    @if (_mensajeExito is not null)
    {
        <div class="alert alert-success" role="alert">@_mensajeExito</div>
    }

    <h2 class="h4">Nueva entrada</h2>
    <p><em>Corregir un dato es agregar una entrada nueva — nunca se edita una entrada ya registrada.</em></p>

    <EditForm Model="_modelo" OnValidSubmit="GuardarEntradaAsync">
        <div class="row" style="max-width: 700px;">
            <div class="col mb-3">
                <label for="doctor" class="form-label">Doctor</label>
                <InputSelect id="doctor" class="form-select" @bind-Value="_modelo.DoctorId">
                    <option value="">-- Selecciona un doctor --</option>
                    @foreach (var doctor in _doctores ?? [])
                    {
                        <option value="@doctor.Id">@doctor.NombreUsuario — @doctor.Especialidad</option>
                    }
                </InputSelect>
            </div>
            <div class="col mb-3">
                <label for="cita" class="form-label">Cita relacionada (opcional)</label>
                <InputSelect id="cita" class="form-select" @bind-Value="_modelo.CitaId">
                    <option value="">-- Sin cita relacionada --</option>
                    @foreach (var cita in _citas ?? [])
                    {
                        <option value="@cita.Id">@cita.FechaHoraInicio.ToString("dd/MM/yyyy HH:mm") — @cita.NombreDoctor</option>
                    }
                </InputSelect>
            </div>
        </div>

        <div class="mb-3" style="max-width: 700px;">
            <label for="motivo" class="form-label">Motivo de consulta</label>
            <InputText id="motivo" class="form-control" @bind-Value="_modelo.MotivoConsulta" />
        </div>

        <div class="mb-3" style="max-width: 700px;">
            <label for="diagnostico" class="form-label">Diagnóstico</label>
            <InputTextArea id="diagnostico" class="form-control" rows="3" @bind-Value="_modelo.Diagnostico" />
        </div>

        <div class="mb-3" style="max-width: 700px;">
            <label for="tratamiento" class="form-label">Tratamiento</label>
            <InputTextArea id="tratamiento" class="form-control" rows="3" @bind-Value="_modelo.Tratamiento" />
        </div>

        <div class="mb-3" style="max-width: 700px;">
            <label for="notas" class="form-label">Notas</label>
            <InputTextArea id="notas" class="form-control" rows="3" @bind-Value="_modelo.Notas" />
        </div>

        <fieldset class="mb-3" style="max-width: 700px;">
            <legend class="h6">Signos vitales (opcional)</legend>
            <div class="row">
                <div class="col-4 mb-2">
                    <label for="presionSistolica" class="form-label">Presión sistólica</label>
                    <InputNumber id="presionSistolica" class="form-control" @bind-Value="_modelo.PresionSistolica" />
                </div>
                <div class="col-4 mb-2">
                    <label for="presionDiastolica" class="form-label">Presión diastólica</label>
                    <InputNumber id="presionDiastolica" class="form-control" @bind-Value="_modelo.PresionDiastolica" />
                </div>
                <div class="col-4 mb-2">
                    <label for="temperatura" class="form-label">Temperatura (°C)</label>
                    <InputNumber id="temperatura" class="form-control" @bind-Value="_modelo.TemperaturaCelsius" />
                </div>
                <div class="col-4 mb-2">
                    <label for="frecuenciaCardiaca" class="form-label">Frecuencia cardíaca</label>
                    <InputNumber id="frecuenciaCardiaca" class="form-control" @bind-Value="_modelo.FrecuenciaCardiaca" />
                </div>
                <div class="col-4 mb-2">
                    <label for="frecuenciaRespiratoria" class="form-label">Frecuencia respiratoria</label>
                    <InputNumber id="frecuenciaRespiratoria" class="form-control" @bind-Value="_modelo.FrecuenciaRespiratoria" />
                </div>
                <div class="col-4 mb-2">
                    <label for="saturacion" class="form-label">Saturación O2 (%)</label>
                    <InputNumber id="saturacion" class="form-control" @bind-Value="_modelo.SaturacionOxigeno" />
                </div>
                <div class="col-4 mb-2">
                    <label for="peso" class="form-label">Peso (kg)</label>
                    <InputNumber id="peso" class="form-control" @bind-Value="_modelo.PesoKg" />
                </div>
                <div class="col-4 mb-2">
                    <label for="talla" class="form-label">Talla (cm)</label>
                    <InputNumber id="talla" class="form-control" @bind-Value="_modelo.TallaCm" />
                </div>
            </div>
        </fieldset>

        <button type="submit" class="btn btn-primary" disabled="@_guardando">Agregar entrada</button>
    </EditForm>

    <hr class="my-4" />

    <h2 class="h4">Entradas registradas</h2>

    @if (_entradas is null)
    {
        <p><em>Cargando...</em></p>
    }
    else if (_entradas.Count == 0)
    {
        <p>Este paciente todavía no tiene entradas en su historial.</p>
    }
    else
    {
        @foreach (var entrada in _entradas)
        {
            <div class="card mb-3" style="max-width: 800px;">
                <div class="card-header d-flex justify-content-between">
                    <span><strong>Versión @entrada.Version</strong> — @entrada.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
                    @if (entrada.EsVersionActual)
                    {
                        <span class="badge bg-success">Vigente</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Reemplazada</span>
                    }
                </div>
                <div class="card-body">
                    <p><strong>Doctor:</strong> @entrada.NombreDoctor</p>
                    @if (entrada.MotivoConsulta is not null)
                    {
                        <p><strong>Motivo:</strong> @entrada.MotivoConsulta</p>
                    }
                    @if (entrada.Diagnostico is not null)
                    {
                        <p><strong>Diagnóstico:</strong> @entrada.Diagnostico</p>
                    }
                    @if (entrada.Tratamiento is not null)
                    {
                        <p><strong>Tratamiento:</strong> @entrada.Tratamiento</p>
                    }
                    @if (entrada.Notas is not null)
                    {
                        <p><strong>Notas:</strong> @entrada.Notas</p>
                    }
                    @if (entrada.SignosVitales is { } sv)
                    {
                        <p class="mb-0"><strong>Signos vitales:</strong> @EtiquetaSignosVitales(sv)</p>
                    }
                </div>
            </div>
        }
    }

    <hr class="my-4" />

    <h2 class="h4">Archivos clínicos</h2>

    @if (_mensajeErrorArchivo is not null)
    {
        <div class="alert alert-danger" role="alert">@_mensajeErrorArchivo</div>
    }

    @if (_entradas is not null && _entradas.Count == 0)
    {
        <p><em>Registra al menos una entrada de historial antes de adjuntar archivos.</em></p>
    }
    else
    {
        <div class="row align-items-end" style="max-width: 700px;">
            <div class="col-4 mb-3">
                <label for="tipoArchivo" class="form-label">Tipo de archivo</label>
                <select id="tipoArchivo" class="form-select" @bind="_tipoArchivoSeleccionado">
                    <option value="@TipoArchivoClinico.Radiografia">Radiografía</option>
                    <option value="@TipoArchivoClinico.FotoIntraoral">Foto intraoral</option>
                    <option value="@TipoArchivoClinico.Pdf">PDF</option>
                    <option value="@TipoArchivoClinico.Laboratorio">Resultado de laboratorio</option>
                </select>
            </div>
            <div class="col-8 mb-3">
                <label for="archivo" class="form-label">Archivo (JPG, PNG o PDF — máximo 15 MB)</label>
                <InputFile id="archivo" class="form-control" accept=".jpg,.jpeg,.png,.pdf" OnChange="SubirArchivoAsync" disabled="@_subiendo" />
            </div>
        </div>
        @if (_subiendo)
        {
            <p><em>Subiendo archivo...</em></p>
        }
    }

    @if (_archivos is null)
    {
        <p><em>Cargando...</em></p>
    }
    else if (_archivos.Count == 0)
    {
        <p>Este paciente no tiene archivos clínicos adjuntos.</p>
    }
    else
    {
        <table class="table" style="max-width: 900px;">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Tamaño</th>
                    <th>Versión</th>
                    <th>Subido por</th>
                    <th>Fecha</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var archivo in _archivos)
                {
                    <tr>
                        <td>@archivo.NombreOriginal</td>
                        <td>@EtiquetaTipoArchivo(archivo.TipoArchivo)</td>
                        <td>@FormatearTamano(archivo.TamanoBytes)</td>
                        <td>@archivo.VersionEntrada</td>
                        <td>@archivo.NombreSubidoPor</td>
                        <td>@archivo.FechaSubida.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a href="@($"archivos-clinicos/{PacienteId}/{archivo.Id}")" target="_blank">Descargar</a>
                            &nbsp;·&nbsp;
                            <button type="button" class="btn btn-link p-0 text-danger" @onclick="() => EliminarArchivoAsync(archivo.Id)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr class="my-4" />

    <h2 class="h4">Procedimientos realizados</h2>

    @if (_mensajeErrorProcedimiento is not null)
    {
        <div class="alert alert-danger" role="alert">@_mensajeErrorProcedimiento</div>
    }
    @if (_mensajeExitoProcedimiento is not null)
    {
        <div class="alert alert-success" role="alert">@_mensajeExitoProcedimiento</div>
    }

    @if (_entradas is not null && _entradas.Count == 0)
    {
        <p><em>Registra al menos una entrada de historial antes de registrar procedimientos.</em></p>
    }
    else if (_catalogoActivo is not null && _catalogoActivo.Count == 0)
    {
        <p><em>La clínica no tiene procedimientos activos en su catálogo — <a href="procedimientos">agrega uno primero</a>.</em></p>
    }
    else
    {
        <EditForm Model="_modeloProcedimiento" OnValidSubmit="RegistrarProcedimientoAsync">
            <div class="row" style="max-width: 800px;">
                <div class="col-4 mb-3">
                    <label for="procedimientoDoctor" class="form-label">Doctor</label>
                    <InputSelect id="procedimientoDoctor" class="form-select" @bind-Value="_modeloProcedimiento.DoctorId">
                        <option value="">-- Selecciona --</option>
                        @foreach (var doctor in _doctores ?? [])
                        {
                            <option value="@doctor.Id">@doctor.NombreUsuario</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-4 mb-3">
                    <label for="procedimientoCatalogo" class="form-label">Procedimiento</label>
                    <InputSelect id="procedimientoCatalogo" class="form-select" @bind-Value="_modeloProcedimiento.ProcedimientoCatalogoId">
                        <option value="">-- Selecciona --</option>
                        @foreach (var procedimiento in _catalogoActivo ?? [])
                        {
                            <option value="@procedimiento.Id">@procedimiento.Codigo — @procedimiento.Nombre (RD$ @procedimiento.PrecioBase.ToString("N2"))</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-4 mb-3">
                    <label for="piezaDental" class="form-label">Pieza dental (opcional)</label>
                    <InputText id="piezaDental" class="form-control" @bind-Value="_modeloProcedimiento.PiezaDental" placeholder="Ej. 16 (notación FDI)" />
                </div>
            </div>

            <div class="row" style="max-width: 800px;">
                <div class="col-4 mb-3">
                    <label for="precioAplicado" class="form-label">Precio aplicado (opcional)</label>
                    <InputNumber id="precioAplicado" class="form-control" @bind-Value="_modeloProcedimiento.PrecioAplicado" />
                    <div class="form-text">Vacío = toma el precio actual del catálogo.</div>
                </div>
                <div class="col-8 mb-3">
                    <label for="notasProcedimiento" class="form-label">Notas (opcional)</label>
                    <InputText id="notasProcedimiento" class="form-control" @bind-Value="_modeloProcedimiento.Notas" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_guardandoProcedimiento">Registrar procedimiento</button>
        </EditForm>
    }

    @if (_procedimientosRealizados is null)
    {
        <p><em>Cargando...</em></p>
    }
    else if (_procedimientosRealizados.Count == 0)
    {
        <p>Este paciente no tiene procedimientos registrados.</p>
    }
    else
    {
        <table class="table" style="max-width: 900px;">
            <thead>
                <tr>
                    <th>Procedimiento</th>
                    <th>Doctor</th>
                    <th>Pieza</th>
                    <th>Precio aplicado</th>
                    <th>Versión</th>
                    <th>Fecha</th>
                    <th>Notas</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var procedimiento in _procedimientosRealizados)
                {
                    <tr>
                        <td>@procedimiento.CodigoProcedimiento — @procedimiento.NombreProcedimiento</td>
                        <td>@procedimiento.NombreDoctor</td>
                        <td>@(procedimiento.PiezaDental ?? "—")</td>
                        <td>RD$ @procedimiento.PrecioAplicado.ToString("N2")</td>
                        <td>@procedimiento.VersionEntrada</td>
                        <td>@procedimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@(procedimiento.Notas ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a class="btn btn-link" href="historiales-clinicos">Volver al listado</a>
}

@code {
    private const long TamanoMaximoBytes = 15 * 1024 * 1024; // 15 MB

    [Parameter]
    public Guid PacienteId { get; set; }

    private PacienteDto? _paciente;
    private bool _noEncontrado;
    private IReadOnlyList<DoctorDto>? _doctores;
    private IReadOnlyList<CitaDto>? _citas;
    private IReadOnlyList<EntradaHistorialClinicoDto>? _entradas;
    private readonly ModeloNuevaEntrada _modelo = new();
    private string? _mensajeError;
    private string? _mensajeExito;
    private bool _guardando;

    private IReadOnlyList<ArchivoClinicoDto>? _archivos;
    private TipoArchivoClinico _tipoArchivoSeleccionado = TipoArchivoClinico.Radiografia;
    private string? _mensajeErrorArchivo;
    private bool _subiendo;

    private IReadOnlyList<ProcedimientoCatalogoDto>? _catalogoActivo;
    private IReadOnlyList<ProcedimientoRealizadoDto>? _procedimientosRealizados;
    private readonly ModeloNuevoProcedimiento _modeloProcedimiento = new();
    private string? _mensajeErrorProcedimiento;
    private string? _mensajeExitoProcedimiento;
    private bool _guardandoProcedimiento;

    protected override async Task OnInitializedAsync()
    {
        _paciente = await PacienteService.ObtenerAsync(PacienteId);
        if (_paciente is null)
        {
            _noEncontrado = true;
            return;
        }

        var todosLosDoctores = await DoctorService.ListarAsync();
        _doctores = todosLosDoctores.Where(d => d.ClinicaId == _paciente.ClinicaId && d.Activo).ToList();

        var todoElCatalogo = await ProcedimientoCatalogoService.ListarAsync();
        _catalogoActivo = todoElCatalogo.Where(p => p.ClinicaId == _paciente.ClinicaId && p.Activo).ToList();

        _citas = await CitaService.ListarPorPacienteAsync(PacienteId);
        _entradas = await HistorialClinicoService.ListarEntradasPorPacienteAsync(PacienteId);
        _archivos = await ArchivoClinicoService.ListarPorPacienteAsync(PacienteId);
        _procedimientosRealizados = await ProcedimientoRealizadoService.ListarPorPacienteAsync(PacienteId);
    }

    private async Task GuardarEntradaAsync()
    {
        _guardando = true;
        _mensajeError = null;
        _mensajeExito = null;

        if (!Guid.TryParse(_modelo.DoctorId, out var doctorId))
        {
            _mensajeError = "Selecciona un doctor.";
            _guardando = false;
            return;
        }

        Guid? citaId = Guid.TryParse(_modelo.CitaId, out var idCita) ? idCita : null;

        SignosVitalesDto? signosVitales = null;
        if (_modelo.PresionSistolica is not null || _modelo.PresionDiastolica is not null || _modelo.TemperaturaCelsius is not null ||
            _modelo.FrecuenciaCardiaca is not null || _modelo.FrecuenciaRespiratoria is not null || _modelo.SaturacionOxigeno is not null ||
            _modelo.PesoKg is not null || _modelo.TallaCm is not null)
        {
            signosVitales = new SignosVitalesDto(
                _modelo.PresionSistolica, _modelo.PresionDiastolica, _modelo.TemperaturaCelsius,
                _modelo.FrecuenciaCardiaca, _modelo.FrecuenciaRespiratoria, _modelo.SaturacionOxigeno,
                _modelo.PesoKg, _modelo.TallaCm);
        }

        var resultado = await HistorialClinicoService.AgregarEntradaAsync(new AgregarEntradaHistorialClinicoRequest(
            PacienteId, doctorId, citaId, _modelo.MotivoConsulta, _modelo.Diagnostico,
            _modelo.Tratamiento, _modelo.Notas, signosVitales));

        _guardando = false;

        if (resultado.EsFallido)
        {
            _mensajeError = resultado.Error.Descripcion;
            return;
        }

        _mensajeExito = "Entrada agregada al historial.";
        _modelo.Reiniciar();
        _entradas = await HistorialClinicoService.ListarEntradasPorPacienteAsync(PacienteId);
    }

    private async Task SubirArchivoAsync(InputFileChangeEventArgs e)
    {
        _mensajeErrorArchivo = null;

        if (e.File.Size > TamanoMaximoBytes)
        {
            _mensajeErrorArchivo = "El archivo supera el tamaño máximo permitido (15 MB).";
            return;
        }

        _subiendo = true;

        try
        {
            await using var contenido = e.File.OpenReadStream(TamanoMaximoBytes);
            var resultado = await ArchivoClinicoService.SubirArchivoAsync(
                PacienteId, _tipoArchivoSeleccionado, e.File.Name, contenido);

            if (resultado.EsFallido)
            {
                _mensajeErrorArchivo = resultado.Error.Descripcion;
                return;
            }

            _archivos = await ArchivoClinicoService.ListarPorPacienteAsync(PacienteId);
        }
        finally
        {
            _subiendo = false;
        }
    }

    private async Task EliminarArchivoAsync(Guid archivoId)
    {
        var resultado = await ArchivoClinicoService.EliminarAsync(PacienteId, archivoId);
        _mensajeErrorArchivo = resultado.EsFallido ? resultado.Error.Descripcion : null;
        _archivos = await ArchivoClinicoService.ListarPorPacienteAsync(PacienteId);
    }

    private async Task RegistrarProcedimientoAsync()
    {
        _guardandoProcedimiento = true;
        _mensajeErrorProcedimiento = null;
        _mensajeExitoProcedimiento = null;

        if (!Guid.TryParse(_modeloProcedimiento.DoctorId, out var doctorId))
        {
            _mensajeErrorProcedimiento = "Selecciona un doctor.";
            _guardandoProcedimiento = false;
            return;
        }

        if (!Guid.TryParse(_modeloProcedimiento.ProcedimientoCatalogoId, out var procedimientoCatalogoId))
        {
            _mensajeErrorProcedimiento = "Selecciona un procedimiento.";
            _guardandoProcedimiento = false;
            return;
        }

        var resultado = await ProcedimientoRealizadoService.RegistrarAsync(new RegistrarProcedimientoRealizadoRequest(
            PacienteId, procedimientoCatalogoId, doctorId, _modeloProcedimiento.PiezaDental,
            _modeloProcedimiento.PrecioAplicado, _modeloProcedimiento.Notas));

        _guardandoProcedimiento = false;

        if (resultado.EsFallido)
        {
            _mensajeErrorProcedimiento = resultado.Error.Descripcion;
            return;
        }

        _mensajeExitoProcedimiento = "Procedimiento registrado.";
        _modeloProcedimiento.Reiniciar();
        _procedimientosRealizados = await ProcedimientoRealizadoService.ListarPorPacienteAsync(PacienteId);
    }

    private static string EtiquetaSignosVitales(SignosVitalesDto sv)
    {
        var partes = new List<string>();
        if (sv.PresionSistolica is not null || sv.PresionDiastolica is not null)
            partes.Add($"PA {sv.PresionSistolica?.ToString("0") ?? "—"}/{sv.PresionDiastolica?.ToString("0") ?? "—"}");
        if (sv.TemperaturaCelsius is not null)
            partes.Add($"Temp {sv.TemperaturaCelsius}°C");
        if (sv.FrecuenciaCardiaca is not null)
            partes.Add($"FC {sv.FrecuenciaCardiaca} lpm");
        if (sv.FrecuenciaRespiratoria is not null)
            partes.Add($"FR {sv.FrecuenciaRespiratoria} rpm");
        if (sv.SaturacionOxigeno is not null)
            partes.Add($"SpO2 {sv.SaturacionOxigeno}%");
        if (sv.PesoKg is not null)
            partes.Add($"Peso {sv.PesoKg} kg");
        if (sv.TallaCm is not null)
            partes.Add($"Talla {sv.TallaCm} cm");

        return partes.Count == 0 ? "—" : string.Join(" · ", partes);
    }

    private static string EtiquetaTipoArchivo(TipoArchivoClinico tipo) => tipo switch
    {
        TipoArchivoClinico.Radiografia => "Radiografía",
        TipoArchivoClinico.FotoIntraoral => "Foto intraoral",
        TipoArchivoClinico.Pdf => "PDF",
        TipoArchivoClinico.Laboratorio => "Laboratorio",
        _ => tipo.ToString()
    };

    private static string FormatearTamano(long bytes)
    {
        if (bytes < 1024)
            return $"{bytes} B";

        if (bytes < 1024 * 1024)
            return $"{bytes / 1024.0:0.#} KB";

        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    private sealed class ModeloNuevaEntrada
    {
        public string DoctorId { get; set; } = string.Empty;
        public string CitaId { get; set; } = string.Empty;
        public string? MotivoConsulta { get; set; }
        public string? Diagnostico { get; set; }
        public string? Tratamiento { get; set; }
        public string? Notas { get; set; }
        public decimal? PresionSistolica { get; set; }
        public decimal? PresionDiastolica { get; set; }
        public decimal? TemperaturaCelsius { get; set; }
        public int? FrecuenciaCardiaca { get; set; }
        public int? FrecuenciaRespiratoria { get; set; }
        public decimal? SaturacionOxigeno { get; set; }
        public decimal? PesoKg { get; set; }
