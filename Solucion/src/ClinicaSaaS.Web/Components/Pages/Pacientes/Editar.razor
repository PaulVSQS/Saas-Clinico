@page "/pacientes/{PacienteId:guid}/editar"
@attribute [Authorize(Policy = ClinicaSaaSAuthorizationPolicies.AdminClinica)]
@rendermode InteractiveServer
@using ClinicaSaaS.Application.Doctores
@using ClinicaSaaS.Application.HistorialesClinicos
@using ClinicaSaaS.Application.Pacientes
@using ClinicaSaaS.Application.Procedimientos
@using ClinicaSaaS.Domain.Personal.Enums
@using ClinicaSaaS.Infrastructure.Identity
@inject IPacienteService PacienteService
@inject IDoctorService DoctorService
@inject IProcedimientoCatalogoService ProcedimientoCatalogoService
@inject IProcedimientoRealizadoService ProcedimientoRealizadoService
@inject IHistorialClinicoService HistorialClinicoService
@inject NavigationManager NavigationManager

<PageTitle>Editar paciente</PageTitle>

@if (_paciente is null && !_noEncontrado)
{
    <p><em>Cargando...</em></p>
}
else if (_noEncontrado)
{
    <p role="alert">Ese paciente no existe.</p>
    <a class="btn btn-link" href="pacientes">Volver al listado</a>
}
else
{
    var paciente = _paciente!;

    <h1>Editar paciente @paciente.NombreCompleto</h1>
    <p><strong>Clínica:</strong> @paciente.NombreClinica</p>

    @if (_mensajeErrorPersonales is not null)
    {
        <div class="alert alert-danger" role="alert">@_mensajeErrorPersonales</div>
    }
    @if (_mensajeExitoPersonales is not null)
    {
        <div class="alert alert-success" role="alert">@_mensajeExitoPersonales</div>
    }

    <h2 class="h4">Datos personales</h2>
    <EditForm Model="_modeloPersonales" OnValidSubmit="GuardarDatosPersonalesAsync">
        <div class="row" style="max-width: 700px;">
            <div class="col mb-3">
                <label for="nombres" class="form-label">Nombres</label>
                <InputText id="nombres" class="form-control" @bind-Value="_modeloPersonales.Nombres" />
            </div>
            <div class="col mb-3">
                <label for="apellidos" class="form-label">Apellidos</label>
                <InputText id="apellidos" class="form-control" @bind-Value="_modeloPersonales.Apellidos" />
            </div>
        </div>

        <div class="row" style="max-width: 700px;">
            <div class="col mb-3">
                <label for="tipoDocumento" class="form-label">Tipo de documento</label>
                <InputSelect id="tipoDocumento" class="form-select" @bind-Value="_modeloPersonales.TipoDocumento">
                    <option value="">-- Sin documento --</option>
                    <option value="@TipoDocumentoIdentidad.Cedula">Cédula</option>
                    <option value="@TipoDocumentoIdentidad.Pasaporte">Pasaporte</option>
                    <option value="@TipoDocumentoIdentidad.ActaNacimiento">Acta de nacimiento (menor)</option>
                </InputSelect>
            </div>
            <div class="col mb-3">
                <label for="numeroDocumento" class="form-label">Número de documento</label>
                <InputText id="numeroDocumento" class="form-control" @bind-Value="_modeloPersonales.NumeroDocumento" placeholder="Ej. 00112345678" />
            </div>
        </div>

        <div class="row" style="max-width: 700px;">
            <div class="col mb-3">
                <label for="fechaNacimiento" class="form-label">Fecha de nacimiento</label>
                <InputDate id="fechaNacimiento" class="form-control" @bind-Value="_modeloPersonales.FechaNacimiento" />
            </div>
            <div class="col mb-3">
                <label for="genero" class="form-label">Género</label>
                <InputSelect id="genero" class="form-select" @bind-Value="_modeloPersonales.Genero">
                    <option value="">-- No especificado --</option>
                    <option value="@Genero.Masculino">Masculino</option>
                    <option value="@Genero.Femenino">Femenino</option>
                </InputSelect>
            </div>
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_guardandoPersonales">Guardar datos personales</button>
    </EditForm>

    <hr class="my-4" />

    @if (_mensajeErrorContacto is not null)
    {
        <div class="alert alert-danger" role="alert">@_mensajeErrorContacto</div>
    }
    @if (_mensajeExitoContacto is not null)
    {
        <div class="alert alert-success" role="alert">@_mensajeExitoContacto</div>
    }

    <h2 class="h4">Contacto</h2>
    <EditForm Model="_modeloContacto" OnValidSubmit="GuardarDatosDeContactoAsync">
        <div class="row" style="max-width: 700px;">
            <div class="col mb-3">
                <label for="telefono" class="form-label">Teléfono</label>
                <InputText id="telefono" class="form-control" @bind-Value="_modeloContacto.Telefono" />
            </div>
            <div class="col mb-3">
                <label for="email" class="form-label">Correo electrónico</label>
                <InputText id="email" type="email" class="form-control" @bind-Value="_modeloContacto.Email" />
            </div>
        </div>

        <div class="mb-3" style="max-width: 700px;">
            <label for="direccion" class="form-label">Dirección</label>
            <InputText id="direccion" class="form-control" @bind-Value="_modeloContacto.Direccion" />
        </div>

        <div class="row" style="max-width: 700px;">
            <div class="col mb-3">
                <label for="contactoNombre" class="form-label">Contacto de emergencia — nombre</label>
                <InputText id="contactoNombre" class="form-control" @bind-Value="_modeloContacto.ContactoEmergenciaNombre" />
            </div>
            <div class="col mb-3">
                <label for="contactoTelefono" class="form-label">Contacto de emergencia — teléfono</label>
                <InputText id="contactoTelefono" class="form-control" @bind-Value="_modeloContacto.ContactoEmergenciaTelefono" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary" disabled="@_guardandoContacto">Guardar contacto</button>
    </EditForm>

    <hr class="my-4" />

    <h2 class="h4">Procedimientos</h2>
    <p>
        Asigna aquí el procedimiento que se le va a hacer al paciente — con su precio, ya queda
        listo para cargarse solo al facturar, sin tener que volver a buscarlo.
    </p>

    @if (_mensajeErrorProcedimiento is not null)
    {
        <div class="alert alert-danger" role="alert">@_mensajeErrorProcedimiento</div>
    }
    @if (_mensajeExitoProcedimiento is not null)
    {
        <div class="alert alert-success" role="alert">@_mensajeExitoProcedimiento</div>
    }

    @if (_catalogoActivo is not null && _catalogoActivo.Count == 0)
    {
        <p><em>La clínica no tiene procedimientos activos en su catálogo — <a href="procedimientos">agrega uno primero</a>.</em></p>
    }
    else if (_doctores is not null && _doctores.Count == 0)
    {
        <p><em>La clínica no tiene doctores activos — <a href="doctores">agrega uno primero</a>.</em></p>
    }
    else
    {
        <EditForm Model="_modeloProcedimiento" OnValidSubmit="AsignarProcedimientoAsync">
            <div class="row" style="max-width: 800px;">
                <div class="col-4 mb-3">
                    <label for="procDoctor" class="form-label">Doctor</label>
                    <InputSelect id="procDoctor" class="form-select" @bind-Value="_modeloProcedimiento.DoctorId">
                        <option value="">-- Selecciona --</option>
                        @foreach (var doctor in _doctores ?? [])
                        {
                            <option value="@doctor.Id">@doctor.NombreUsuario</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-4 mb-3">
                    <label for="procCatalogo" class="form-label">Procedimiento</label>
                    <InputSelect id="procCatalogo" class="form-select" @bind-Value="_modeloProcedimiento.ProcedimientoCatalogoId">
                        <option value="">-- Selecciona --</option>
                        @foreach (var procedimiento in _catalogoActivo ?? [])
                        {
                            <option value="@procedimiento.Id">@procedimiento.Codigo — @procedimiento.Nombre (RD$ @procedimiento.PrecioBase.ToString("N2"))</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-4 mb-3">
                    <label for="procPieza" class="form-label">Pieza dental (opcional)</label>
                    <InputText id="procPieza" class="form-control" @bind-Value="_modeloProcedimiento.PiezaDental" placeholder="Ej. 16 (notación FDI)" />
                </div>
            </div>

            <div class="row" style="max-width: 800px;">
                <div class="col-4 mb-3">
                    <label for="procPrecio" class="form-label">Precio (opcional)</label>
                    <InputNumber id="procPrecio" class="form-control" @bind-Value="_modeloProcedimiento.PrecioAplicado" />
                    <div class="form-text">Vacío = toma el precio actual del catálogo.</div>
                </div>
                <div class="col-8 mb-3">
                    <label for="procNotas" class="form-label">Notas (opcional)</label>
                    <InputText id="procNotas" class="form-control" @bind-Value="_modeloProcedimiento.Notas" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@_guardandoProcedimiento">Asignar procedimiento</button>
        </EditForm>
    }

    @if (_procedimientosAsignados is null)
    {
        <p><em>Cargando...</em></p>
    }
    else if (_procedimientosAsignados.Count == 0)
    {
        <p>Este paciente todavía no tiene procedimientos asignados.</p>
    }
    else
    {
        <table class="table" style="max-width: 900px;">
            <thead>
                <tr>
                    <th>Procedimiento</th>
                    <th>Doctor</th>
                    <th>Pieza</th>
                    <th>Precio</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var procedimiento in _procedimientosAsignados)
                {
                    <tr>
                        <td>@procedimiento.CodigoProcedimiento — @procedimiento.NombreProcedimiento</td>
                        <td>@procedimiento.NombreDoctor</td>
                        <td>@(procedimiento.PiezaDental ?? "—")</td>
                        <td>RD$ @procedimiento.PrecioAplicado.ToString("N2")</td>
                        <td>@procedimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <p><a href="@($"historiales-clinicos/{PacienteId}")">Ver historial clínico completo</a></p>

    <hr class="my-4" />
    <a class="btn btn-link" href="pacientes">Volver al listado</a>
}

@code {
    [Parameter]
    public Guid PacienteId { get; set; }

    private PacienteDto? _paciente;
    private bool _noEncontrado;

    private readonly ModeloDatosPersonales _modeloPersonales = new();
    private string? _mensajeErrorPersonales;
    private string? _mensajeExitoPersonales;
    private bool _guardandoPersonales;

    private readonly ModeloDatosDeContacto _modeloContacto = new();
    private string? _mensajeErrorContacto;
    private string? _mensajeExitoContacto;
    private bool _guardandoContacto;

    private IReadOnlyList<DoctorDto>? _doctores;
    private IReadOnlyList<ProcedimientoCatalogoDto>? _catalogoActivo;
    private IReadOnlyList<ProcedimientoRealizadoDto>? _procedimientosAsignados;
    private readonly ModeloNuevoProcedimiento _modeloProcedimiento = new();
    private string? _mensajeErrorProcedimiento;
    private string? _mensajeExitoProcedimiento;
    private bool _guardandoProcedimiento;

    protected override async Task OnInitializedAsync()
    {
        _paciente = await PacienteService.ObtenerAsync(PacienteId);
        if (_paciente is null)
        {
            _noEncontrado = true;
            return;
        }

        var todosLosDoctores = await DoctorService.ListarAsync();
        _doctores = todosLosDoctores.Where(d => d.ClinicaId == _paciente.ClinicaId && d.Activo).ToList();

        var todoElCatalogo = await ProcedimientoCatalogoService.ListarAsync();
        _catalogoActivo = todoElCatalogo.Where(p => p.ClinicaId == _paciente.ClinicaId && p.Activo).ToList();

        _procedimientosAsignados = await ProcedimientoRealizadoService.ListarPorPacienteAsync(PacienteId);

        _modeloPersonales.Nombres = _paciente.Nombres;
        _modeloPersonales.Apellidos = _paciente.Apellidos;
        _modeloPersonales.TipoDocumento = _paciente.TipoDocumento;
        _modeloPersonales.NumeroDocumento = _paciente.NumeroDocumento;
        _modeloPersonales.FechaNacimiento = _paciente.FechaNacimiento;
        _modeloPersonales.Genero = _paciente.Genero;

        _modeloContacto.Telefono = _paciente.Telefono;
        _modeloContacto.Email = _paciente.Email;
        _modeloContacto.Direccion = _paciente.Direccion;
        _modeloContacto.ContactoEmergenciaNombre = _paciente.ContactoEmergenciaNombre;
        _modeloContacto.ContactoEmergenciaTelefono = _paciente.ContactoEmergenciaTelefono;
    }

    private async Task GuardarDatosPersonalesAsync()
    {
        _guardandoPersonales = true;
        _mensajeErrorPersonales = null;
        _mensajeExitoPersonales = null;

        var resultado = await PacienteService.ActualizarDatosPersonalesAsync(PacienteId, new ActualizarDatosPersonalesPacienteRequest(
            _modeloPersonales.Nombres, _modeloPersonales.Apellidos, _modeloPersonales.TipoDocumento,
            _modeloPersonales.NumeroDocumento, _modeloPersonales.FechaNacimiento, _modeloPersonales.Genero));

        _guardandoPersonales = false;

        if (resultado.EsFallido)
        {
            _mensajeErrorPersonales = resultado.Error.Descripcion;
            return;
        }

        _mensajeExitoPersonales = "Datos personales actualizados.";
    }

    private async Task GuardarDatosDeContactoAsync()
    {
        _guardandoContacto = true;
        _mensajeErrorContacto = null;
        _mensajeExitoContacto = null;

        var resultado = await PacienteService.ActualizarDatosDeContactoAsync(PacienteId, new ActualizarDatosDeContactoPacienteRequest(
            _modeloContacto.Telefono, _modeloContacto.Email, _modeloContacto.Direccion,
            _modeloContacto.ContactoEmergenciaNombre, _modeloContacto.ContactoEmergenciaTelefono));

        _guardandoContacto = false;

        if (resultado.EsFallido)
        {
            _mensajeErrorContacto = resultado.Error.Descripcion;
            return;
        }

        _mensajeExitoContacto = "Contacto actualizado.";
    }

    private sealed class ModeloDatosPersonales
    {
        public string Nombres { get; set; } = string.Empty;
        public string Apellidos { get; set; } = string.Empty;
        public TipoDocumentoIdentidad? TipoDocumento { get; set; }
        public string? NumeroDocumento { get; set; }
        public DateOnly? FechaNacimiento { get; set; }
        public Genero? Genero { get; set; }
    }

    private sealed class ModeloDatosDeContacto
    {
        public string? Telefono { get; set; }
        public string? Email { get; set; }
        public string? Direccion { get; set; }
        public string? ContactoEmergenciaNombre { get; set; }
        public string? ContactoEmergenciaTelefono { get; set; }
    }

    /// <summary>
    /// La costura: ProcedimientoRealizadoService exige una entrada activa de HistorialClinico
    /// para poder colgar el procedimiento (ver ProcedimientoRealizado.SinEntradas). En vez de
    /// obligar al usuario a ir primero a Historia Clínica a crear una entrada manualmente, se
    /// crea aquí una entrada mínima ("Registro inicial") de forma perezosa, con el mismo doctor
    /// seleccionado, reutilizando HistorialClinicoService.AgregarEntradaAsync — sin tocar el
    /// dominio de Historia Clínica ni de Procedimientos.
    /// </summary>
    private async Task AsignarProcedimientoAsync()
    {
        _guardandoProcedimiento = true;
        _mensajeErrorProcedimiento = null;
        _mensajeExitoProcedimiento = null;

        if (!Guid.TryParse(_modeloProcedimiento.DoctorId, out var doctorId))
        {
            _mensajeErrorProcedimiento = "Selecciona un doctor.";
            _guardandoProcedimiento = false;
            return;
        }

        if (!Guid.TryParse(_modeloProcedimiento.ProcedimientoCatalogoId, out var procedimientoCatalogoId))
        {
            _mensajeErrorProcedimiento = "Selecciona un procedimiento.";
            _guardandoProcedimiento = false;
            return;
        }

        var entradas = await HistorialClinicoService.ListarEntradasPorPacienteAsync(PacienteId);
        if (!entradas.Any(e => e.EsVersionActual))
        {
            var creacionEntrada = await HistorialClinicoService.AgregarEntradaAsync(new AgregarEntradaHistorialClinicoRequest(
                PacienteId, doctorId, null, "Registro inicial", null, null, null, null));

            if (creacionEntrada.EsFallido)
            {
                _mensajeErrorProcedimiento = creacionEntrada.Error.Descripcion;
                _guardandoProcedimiento = false;
                return;
            }
        }

        var resultado = await ProcedimientoRealizadoService.RegistrarAsync(new RegistrarProcedimientoRealizadoRequest(
            PacienteId, procedimientoCatalogoId, doctorId, _modeloProcedimiento.PiezaDental,
            _modeloProcedimiento.PrecioAplicado, _modeloProcedimiento.Notas));

        _guardandoProcedimiento = false;

        if (resultado.EsFallido)
        {
            _mensajeErrorProcedimiento = resultado.Error.Descripcion;
            return;
        }

        _mensajeExitoProcedimiento = "Procedimiento asignado — ya queda listo para cargarse solo al facturar.";
        _modeloProcedimiento.Reiniciar();
        _procedimientosAsignados = await ProcedimientoRealizadoService.ListarPorPacienteAsync(PacienteId);
    }

    private sealed class ModeloNuevoProcedimiento
    {
        public string DoctorId { get; set; } = string.Empty;
        public string ProcedimientoCatalogoId { get; set; } = string.Empty;
        public string? PiezaDental { get; set; }
        public decimal? PrecioAplicado { get; set; }
        public string? Notas { get; set; }

        public void Reiniciar()
        {
            PiezaDental = null;
            PrecioAplicado = null;
            Notas = null;
            // DoctorId y ProcedimientoCatalogoId se dejan como estaban — es común asignar
            // varios procedimientos seguidos para el mismo doctor/tipo.
        }
    }
}