@page "/consultorios/nuevo"
@attribute [Authorize(Policy = ClinicaSaaSAuthorizationPolicies.AdminClinica)]
@rendermode InteractiveServer
@using ClinicaSaaS.Application.Clinicas
@using ClinicaSaaS.Application.Common.Interfaces
@using ClinicaSaaS.Application.Consultorios
@using ClinicaSaaS.Infrastructure.Identity
@inject IConsultorioService ConsultorioService
@inject IClinicaService ClinicaService
@inject ITenantContext TenantContext
@inject NavigationManager NavigationManager

<PageTitle>Nuevo consultorio</PageTitle>

<h1>Nuevo consultorio</h1>

@if (_mensajeError is not null)
{
    <div class="alert alert-danger" role="alert">@_mensajeError</div>
}

<EditForm Model="_modelo" OnValidSubmit="GuardarAsync">
    @if (TenantContext.ClinicaId is null)
    {
        @if (_clinicas is null)
        {
            <p><em>Cargando...</em></p>
        }
        else
        {
            <div class="mb-3" style="max-width: 500px;">
                <label for="clinica" class="form-label">Clínica</label>
                <InputSelect id="clinica" class="form-select" @bind-Value="_modelo.ClinicaId">
                    <option value="">-- Selecciona una clínica --</option>
                    @foreach (var clinica in _clinicas)
                    {
                        <option value="@clinica.Id">@clinica.NombreComercial</option>
                    }
                </InputSelect>
                <div class="form-text">
                    Como SuperAdmin SaaS puedes elegir la clínica; un AdminClinica normal registra
                    consultorios directo en su propia clínica, sin este selector.
                </div>
            </div>
        }
    }

    <div class="mb-3" style="max-width: 500px;">
        <label for="nombre" class="form-label">Nombre</label>
        <InputText id="nombre" class="form-control" @bind-Value="_modelo.Nombre" placeholder="Ej. Consultorio 1" />
    </div>

    <div class="mb-3" style="max-width: 300px;">
        <label for="piso" class="form-label">Piso (opcional)</label>
        <InputText id="piso" class="form-control" @bind-Value="_modelo.Piso" placeholder="Ej. 2" />
    </div>

    <button type="submit" class="btn btn-primary" disabled="@_guardando">Registrar consultorio</button>
    <a class="btn btn-link" href="consultorios">Cancelar</a>
</EditForm>

@code {
    private IReadOnlyList<ClinicaDto>? _clinicas;
    private readonly ModeloNuevoConsultorio _modelo = new();
    private string? _mensajeError;
    private bool _guardando;

    protected override async Task OnInitializedAsync()
    {
        // El selector de clínica solo hace falta para un SuperAdmin SaaS (sin clínica activa
        // en su sesión) — un AdminClinica normal no lo necesita, así que no cargamos la lista
        // completa de clínicas de balde en ese caso. Mismo criterio que Doctores/Nuevo.razor y
        // Empleados/Nueva.razor (Módulos 3 y 4).
        if (TenantContext.ClinicaId is null)
            _clinicas = await ClinicaService.ListarAsync();
    }

    private async Task GuardarAsync()
    {
        _guardando = true;
        _mensajeError = null;

        Guid clinicaId;
        if (TenantContext.ClinicaId is Guid clinicaActiva)
        {
            clinicaId = clinicaActiva;
        }
        else if (!Guid.TryParse(_modelo.ClinicaId, out clinicaId))
        {
            _mensajeError = "Selecciona una clínica.";
            _guardando = false;
            return;
        }

        var resultado = await ConsultorioService.RegistrarAsync(
            new RegistrarConsultorioRequest(clinicaId, _modelo.Nombre, _modelo.Piso));

        if (resultado.EsFallido)
        {
            _mensajeError = resultado.Error.Descripcion;
            _guardando = false;
            return;
        }

        NavigationManager.NavigateTo("consultorios");
    }

    private sealed class ModeloNuevoConsultorio
    {
        public string ClinicaId { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string? Piso { get; set; }
    }
}
