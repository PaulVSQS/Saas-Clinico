@page "/doctores/{DoctorId:guid}/editar"
@attribute [Authorize(Policy = ClinicaSaaSAuthorizationPolicies.AdminClinica)]
@rendermode InteractiveServer
@using ClinicaSaaS.Application.Doctores
@using ClinicaSaaS.Infrastructure.Identity
@inject IDoctorService DoctorService
@inject NavigationManager NavigationManager

<PageTitle>Editar doctor</PageTitle>

@if (_doctor is null && !_noEncontrado)
{
    <p><em>Cargando...</em></p>
}
else if (_noEncontrado)
{
    <p role="alert">Ese doctor no existe.</p>
    <a class="btn btn-link" href="doctores">Volver al listado</a>
}
else
{
    var doctor = _doctor!;

    <h1>Editar doctor @doctor.NombreUsuario</h1>

    <dl class="row">
        <dt class="col-sm-2">Usuario</dt>
        <dd class="col-sm-10">@doctor.NombreUsuario (@doctor.EmailUsuario)</dd>
        <dt class="col-sm-2">Clínica</dt>
        <dd class="col-sm-10">@doctor.NombreClinica</dd>
    </dl>
    <p><em>El usuario y la clínica no se editan aquí — para eso hay que revocar y volver a registrar el doctor.</em></p>

    @if (_mensajeError is not null)
    {
        <div class="alert alert-danger" role="alert">@_mensajeError</div>
    }
    @if (_mensajeExito is not null)
    {
        <div class="alert alert-success" role="alert">@_mensajeExito</div>
    }

    <EditForm Model="_modelo" OnValidSubmit="GuardarAsync">
        <div class="mb-3" style="max-width: 500px;">
            <label for="especialidad" class="form-label">Especialidad</label>
            <InputText id="especialidad" class="form-control" @bind-Value="_modelo.Especialidad" />
        </div>

        <div class="mb-3" style="max-width: 300px;">
            <label for="exequatur" class="form-label">Número de exequátur (opcional)</label>
            <InputText id="exequatur" class="form-control" @bind-Value="_modelo.NumeroExequatur" />
        </div>

        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a class="btn btn-link" href="doctores">Volver al listado</a>
    </EditForm>
}

@code {
    [Parameter]
    public Guid DoctorId { get; set; }

    private DoctorDto? _doctor;
    private bool _noEncontrado;
    private string? _mensajeError;
    private string? _mensajeExito;
    private readonly ModeloDatosDoctor _modelo = new();

    protected override async Task OnInitializedAsync()
    {
        _doctor = await DoctorService.ObtenerAsync(DoctorId);
        if (_doctor is null)
        {
            _noEncontrado = true;
            return;
        }

        _modelo.Especialidad = _doctor.Especialidad;
        _modelo.NumeroExequatur = _doctor.NumeroExequatur;
    }

    private async Task GuardarAsync()
    {
        _mensajeError = null;
        _mensajeExito = null;

        var resultado = await DoctorService.ActualizarDatosAsync(
            DoctorId, new ActualizarDatosDoctorRequest(_modelo.Especialidad, _modelo.NumeroExequatur));

        if (resultado.EsFallido)
        {
            _mensajeError = resultado.Error.Descripcion;
            return;
        }

        _mensajeExito = "Datos actualizados.";
    }

    private sealed class ModeloDatosDoctor
    {
        public string Especialidad { get; set; } = string.Empty;
        public string? NumeroExequatur { get; set; }
    }
}
