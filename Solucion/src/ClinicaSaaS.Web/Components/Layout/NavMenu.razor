<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ClinicaSaaS.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="counter">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Counter
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="weather">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Weather
            </NavLink>
        </div>

        <AuthorizeView Policy="@ClinicaSaaSAuthorizationPolicies.SuperAdminSaaS">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="clinicas">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Clínicas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="usuarios">
                    <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> Usuarios
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="@ClinicaSaaSAuthorizationPolicies.AdminClinica">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="empleados">
                    <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> Empleados
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="doctores">
                    <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> Doctores
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="consultorios">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Consultorios
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="horarios">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Horarios
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="pacientes">
                    <span class="bi bi-person-lines-fill-nav-menu" aria-hidden="true"></span> Pacientes
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="citas">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Citas
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="historiales-clinicos">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Historia Clínica
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="procedimientos">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Procedimientos
                </NavLink>
            </div>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="mi-cuenta">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form method="post" action="Account/Logout">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link btn btn-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Cerrar sesión
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Iniciar sesión
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>